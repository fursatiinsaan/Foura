# ═══════════════════════════════════════════════════════════════
# Foura AI Revenue Recovery Engine — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Groq API Key (LLaMA-3 inference — free at https://console.groq.com)
OPENAI_API_KEY=gsk_your_groq_api_key_here

# Razorpay Test Mode Keys (from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay Webhook Secret (set in Razorpay Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Database (default SQLite — no changes needed for local dev)
DATABASE_URL=sqlite+aiosqlite:///./recovery_agent.db
